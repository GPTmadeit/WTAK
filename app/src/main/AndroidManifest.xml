<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declares this as a watch app -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Tiles are downloaded/cached over the network; CoT mesh uses UDP multicast -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Meshtastic LoRa radio over BLE — the team link with no server or IP network.
         The watch is a BLE central only; neverForLocation keeps the scan out of
         the location-permission story, since we are not deriving position from it. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pre-Android-12 equivalents; superseded by the two above from API 31. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Position of the wearer -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Keep the GPS awake while the map is showing / ambient mode -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Continue tracking + CoT publishing with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Ongoing notification for the tracking service (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Update the app from its own GitHub releases, on the watch. This is a
         sideloaded app with no store behind it, so without this the only way to
         take a fix is a computer and a cable. The platform still asks the
         wearer to confirm every install, and still refuses any APK not signed
         with the same key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ATAKWatchApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Runs without a paired phone -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Glanceable status tile, one swipe from the watch face. -->
        <service
            android:name=".tile.StatusTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_launcher_foreground" />
        </service>

        <!-- Outcome of a self-update install session. Not exported: the only
             sender is our own PendingIntent, handed to the package installer. -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.atakwatch.minimap.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Receives identity + relayed CoT from a paired EUD running ATAK. -->
        <service
            android:name=".bridge.EudListenerService"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/atak" />
            </intent-filter>
        </service>
    </application>
</manifest>
