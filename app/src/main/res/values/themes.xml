<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full-screen black background suits a map + Wear OS. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>

        <!--
            windowSwipeToDismiss is deliberately left ON.

            It is tempting to disable it: Wear dismisses on any left-to-right
            swipe anywhere on screen, which on a map is the same movement as a
            pan. But the Wear Compose nav host takes its back gesture *from the
            platform* — turning this off doesn't hand back navigation to the
            app, it removes the gesture source entirely and no screen can be
            swiped back from at all.

            Panning is kept separate from back by excluding the map's interior
            from the system gesture instead; see MapScreen's exclusion rects.
        -->
        <item name="android:windowSwipeToDismiss">true</item>
    </style>
</resources>
