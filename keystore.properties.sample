# Copy to keystore.properties (untracked) to sign release builds.
# Without it — and without the environment variables below — `assembleRelease`
# still succeeds, but produces an UNSIGNED APK.
#
# Generate a keystore:
#
#   keytool -genkeypair -alias atakwatch \
#     -dname "CN=Your Name, O=Your Org, C=US" \
#     -keyalg RSA -keysize 4096 -sigalg SHA256withRSA \
#     -validity 10000 -keystore release.jks -storetype PKCS12
#
# storeFile is resolved relative to the project root.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=atakwatch
keyPassword=CHANGE_ME

# CI alternative — set these instead and keep no secrets on disk. Environment
# variables take precedence over this file:
#
#   ATAKWATCH_STORE_FILE
#   ATAKWATCH_STORE_PASSWORD
#   ATAKWATCH_KEY_ALIAS
#   ATAKWATCH_KEY_PASSWORD
